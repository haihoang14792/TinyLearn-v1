# TinyLearn - Bé Khám Phá (Environment Configuration)
# Note: Client-side keys must start with VITE_

PORT=3000
NODE_ENV=development

# Optional Gemini API Key for Server-side AI Game & Lesson Plan Generation
# (TinyLearn includes built-in rich pedagogical generators that work seamlessly even without this key!)
GEMINI_API_KEY=

# Optional Supabase Database & Auth Integration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
